{
  "reporter": [
    "text",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "./coverage",
  "exclude": [
    "tests/**",
    "node_modules/**",
    "coverage/**",
    "jest.config.js",
    ".nycrc.json"
  ],
  "include": [
    "routes/**/*.js",
    "middleware/**/*.js",
    "config/**/*.js",
    "server.js"
  ],
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80,
  "watermarks": {
    "lines": [80, 95],
    "functions": [80, 95],
    "branches": [80, 95],
    "statements": [80, 95]
  }
}
